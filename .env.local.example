# Frontend env — copy to .env.local
#
# Base URL of the Python API (engram/api.py). The client in src/lib/api.ts
# defaults to http://localhost:8000 when this is unset, and falls back to mock
# fixtures whenever the API is unreachable, so the app runs without a backend.
NEXT_PUBLIC_ENGRAM_API_URL=http://localhost:8000
